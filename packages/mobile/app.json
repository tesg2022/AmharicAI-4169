{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.amharicai_zoin.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B6E4F"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://amharic-zoinof5-preview-4200.runable.site/",
      "applicationId": "amharic-zoinof5",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.amharicai_zoin.capetown",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#FBF7EF"
    },
    "name": "AmharicAI",
    "slug": "amharicai",
    "version": "1.0.1",
    "scheme": "runable-amharic-zoinof5",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-font"
    ]
  }
}